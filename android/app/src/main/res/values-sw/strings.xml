<?xml version="1.0" encoding="utf-8"?>
<!--
    Swahili, a draft not yet read by a fluent reviewer (#495). The notes on each string are in values/strings.xml.
    Everyday Kenyan Swahili, addressing the driver as "wewe". "Vehicle" is gari (class 5: gari lako, magari),
    never the word for bus, not even in its other sense "then"; "run" is raundi; "trip" is safari; "report" is
    ripoti (class 9/10: ripoti 1 imetumwa, ripoti 5 zimetumwa); "stop" is kituo; "route" is njia; "block" is bloku;
    "agency" is shirika; "dispatcher" is mratibu, and the agency's admin is msimamizi; "timetable" and "schedule"
    are ratiba; "sign in" is ingia and "sign out" is ondoka; "location" is mahali, as Android's Swahili settings say;
    "diagnostics" is taarifa za programu. Minutes are "dak" before the number, as Swahili puts the unit first.
-->
